# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file (it is listed in .gitignore).

# Supabase: Project Settings > API Keys
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side only. Do NOT put this in React code, and do not use a VITE_ prefix.
# Anything starting with VITE_ is visible to whoever opens the app.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket names (created by supabase/migrations/0001_init.sql)
VITE_BUCKET_RESERVE=reserve-expenses
VITE_BUCKET_PROJECT_INVOICES=project-invoices
VITE_BUCKET_CLIENT_PAYMENTS=client-payments
VITE_BUCKET_PRODUCTS=product-invoices
VITE_BUCKET_BONDS_CLIENTS=bonds-clients
VITE_BUCKET_BONDS_FOUNDERS=bonds-founders
VITE_BUCKET_BONDS_EMPLOYEES=bonds-employees
VITE_BUCKET_EXPORTS=exports

# Future APIs (add when needed)
# VITE_EMAIL_API_KEY=
# VITE_GST_API_KEY=
# VITE_PAYMENT_GATEWAY_KEY=
